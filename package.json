{
  "name": "enrm-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "npm run generate:legacy-pages && next dev",
    "dev:next": "npm run dev",
    "build": "npm run generate:legacy-pages && opennextjs-cloudflare build",
    "build:next": "npm run generate:legacy-pages && next build --webpack",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src scripts tests *.html *.json *.ts *.md",
    "format:check": "prettier --check src scripts tests *.html *.json *.ts *.md",
    "generate:legacy-pages": "node scripts/generate-legacy-pages.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "backend:start": "supabase start",
    "backend:stop": "supabase stop",
    "backend:status": "supabase status",
    "backend:reset": "supabase db reset --local",
    "backend:lint": "supabase db lint --local",
    "backend:seed": "node scripts/generate-supabase-seed.mjs"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/postcss": "^4.3.5",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  }
}
